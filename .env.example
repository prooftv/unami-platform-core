# Supabase — Moments (apps/admin, apps/web)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-placeholder-value
SUPABASE_SERVICE_ROLE_KEY=your-placeholder-value
# API
NEXT_PUBLIC_API_URL=https://example.invalid
SUPABASE_ACCESS_TOKEN=your-placeholder-value
# App URLs (used for CORS)
NEXT_PUBLIC_ADMIN_URL=https://example.invalid
NEXT_PUBLIC_APP_URL=https://example.invalid
NEXT_PUBLIC_WEB_URL=https://example.invalid
NEXT_PUBLIC_UNCIP_URL=https://example.invalid

# Vercel — stored here so scripts can read it without re-entry each session
# Refresh at: vercel.com/account/tokens — create token named "unami-platform-core-dev" with no expiry
# Used by: scripts/deploy-umkhandlu-functions.mjs (via VERCEL_TOKEN env var)
VERCEL_TOKEN=your-placeholder-value                      # paste token here after generating at vercel.com/account/tokens

# Supabase — Umkhandlu Control Centre (apps/umkhandlu) — separate Supabase project

NEXT_PUBLIC_UMKHANDLU_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_UMKHANDLU_SUPABASE_ANON_KEY=your-placeholder-value
UMKHANDLU_SUPABASE_SERVICE_ROLE_KEY=your-placeholder-value

# Supabase — UNCIP (apps/uncip) — separate Supabase project

NEXT_PUBLIC_UNCIP_SUPABASE_URL=https://your-project.supabase.co                # UNCIP Supabase project URL
NEXT_PUBLIC_UNCIP_SUPABASE_ANON_KEY=your-placeholder-value           # UNCIP Supabase anon key
UNCIP_SUPABASE_SERVICE_ROLE_KEY=your-placeholder-value               # UNCIP Supabase service role key (Edge Functions only)

# WhatsApp
WHATSAPP_TOKEN=your-placeholder-value                   # Edge Functions only
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id         # Edge Functions only
WEBHOOK_VERIFY_TOKEN=your-placeholder-value             # Edge Functions only
WEBHOOK_HMAC_SECRET=your-placeholder-value              # Edge Functions only
WHATSAPP_DEFAULT_TEMPLATE=your-template-name        # Edge Functions only — approved template name for broadcasts (optional, falls back to free text)

# AI (optional)
ANTHROPIC_API_KEY=your-placeholder-value                # Edge Functions only — enables Claude analysis

# n8n
N8N_WEBHOOK_URL=https://example.invalid
N8N_API_KEY=your-placeholder-value

# Sanity CMS (apps/web only — Phase 17C)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=your-dataset
SANITY_REVALIDATE_SECRET=your-placeholder-value          # Random secret — set in Sanity webhook config
SANITY_API_WRITE_TOKEN=your-placeholder-value
# Spatial Scheduler (apps/umkhandlu — GIS-5)
SPATIAL_SCHEDULER_SECRET=your-placeholder-value          # Random secret — set in Vercel + GitHub Actions secret SPATIAL_SCHEDULER_SECRET
